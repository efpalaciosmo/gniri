#!/usr/bin/env python3
"""Stage verified updates only; never restart the machine."""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile

POLICY = '/usr/share/gniri/bootc-policy.json'
STATE = Path('/var/lib/gniri/updates/status.json')
PAUSE = Path('/etc/gniri/updates-paused')
REFERENCE_FILE = Path('/usr/share/gniri/image-reference')
BUILD_FILE = Path('/usr/share/gniri/build.json')


class UpdateSkipped(Exception):
    """A deliberate safety stop, not a network failure to retry."""


def policy_environment(reference):
    policy = json.loads(Path(POLICY).read_text())
    repository = reference.rsplit(':', 1)[0]
    rule = policy['transports']['docker'][repository]
    expected = [{'type': 'sigstoreSigned', 'keyPath': '/usr/share/gniri/keys/cosign.pub',
                 'signedIdentity': {'type': 'matchRepository'}}]
    if (policy['default'] != [{'type': 'reject'}] or rule != expected
            or set(policy['transports']) != {'docker'}
            or set(policy['transports']['docker']) != {repository}):
        raise ValueError('The immutable Gniri bootc signature policy is not strict')
    return dict(os.environ, CONTAINERS_POLICY_JSON=POLICY)


def save_state(path, outcome, message, now=None, staged_digest=None):
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    try:
        state = json.loads(path.read_text()) if path.exists() else {}
    except json.JSONDecodeError:
        state = {'previous_state_error': 'Previous status record was invalid JSON.'}
    if not isinstance(state, dict):
        state = {'previous_state_error': 'Previous status record was not a JSON object.'}
    now = now or datetime.now(timezone.utc).isoformat()
    state.update(last_attempt=now, outcome=outcome, message=message)
    if outcome == 'success':
        state['last_success'] = now
        state['staged_digest'] = staged_digest
    descriptor, name = tempfile.mkstemp(prefix='.status-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(state, stream, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, 0o644)
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def update_reference(reference, status):
    if not reference.startswith('ghcr.io/'):
        raise UpdateSkipped('Local development image: registry updates are unavailable.')
    if status['spec'].get('bootOrder') == 'rollback' or status['status'].get('rollbackQueued'):
        raise UpdateSkipped('Rollback queued; update skipped.')
    booted = status['status']['booted']['image']['image']
    target = status['spec'].get('image')
    repository = reference.rsplit(':', 1)[0]
    if (not target or booted['image'] != target['image']
            or booted.get('transport') != 'registry' or target['transport'] != 'registry'
            or target['image'] not in (repository + ':stable', repository + ':latest')):
        raise UpdateSkipped('Update source differs from this image. Review the source before updating.')
    return target['image']


def stage_update(reference, status, environment=None):
    reference = update_reference(reference, status)
    target = status['spec']['image']
    if target.get('signature') != 'containerPolicy':
        # Compatibility with older installations. New installers enroll the
        # signed origin offline; switch also stages a verified update here.
        subprocess.run(['bootc', 'switch', '--enforce-container-sigpolicy', reference],
                       check=True, env=environment)
    else:
        subprocess.run(['bootc', 'upgrade'], check=True, env=environment)


def check_version(reference, current, environment):
    # Fail closed for legacy/unlabelled targets. Publication also checks this
    # against the stable channel before changing its tag.
    metadata = json.loads(subprocess.check_output(
        ['skopeo', 'inspect', f'docker://{reference}'], env=environment, text=True))
    version = (metadata.get('Labels') or {}).get('org.opencontainers.image.version', '')
    if not isinstance(version, str) or not re.fullmatch(r'[1-9][0-9]*', version):
        raise ValueError('Update image lacks its Fedora version label; publish a validated candidate first.')
    if int(version) < int(current):
        raise ValueError(f'Refusing Fedora downgrade: {current} -> {version}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--status', action='store_true', help='Show last attempt and current deployments')
    args = parser.parse_args()
    if args.status:
        print(STATE.read_text() if STATE.exists() else 'No update check has been recorded.')
        subprocess.run(['bootc', 'status'], check=True)
        return 0
    if os.geteuid() != 0:
        parser.error('Run with sudo, or use --status to inspect update state.')
    try:
        reference = REFERENCE_FILE.read_text().strip()
        if PAUSE.exists():
            raise UpdateSkipped('Updates paused by /etc/gniri/updates-paused.')
        if not reference.startswith('ghcr.io/'):
            raise UpdateSkipped('Local development image: registry updates are unavailable.')
        status = json.loads(subprocess.check_output(['bootc', 'status', '--json']))
        reference = update_reference(reference, status)
        environment = policy_environment(reference)
        current = json.loads(BUILD_FILE.read_text())['fedora_version']
        check_version(reference, current, environment)
        stage_update(reference, status, environment)
        status = json.loads(subprocess.check_output(['bootc', 'status', '--json']))
        staged = status['status'].get('staged')
        message = ('Verified deployment staged; reboot manually when ready.' if staged else
                   'Verified update check completed; no reboot is needed.')
        digest = staged.get('image', {}).get('imageDigest') if staged else None
        save_state(STATE, 'success', message, staged_digest=digest)
        print(message)
        return 0
    except UpdateSkipped as error:
        save_state(STATE, 'skipped', str(error))
        print(error)
        return 0
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        save_state(STATE, 'failed', str(error))
        print(f'Update failed: {error}', flush=True)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
