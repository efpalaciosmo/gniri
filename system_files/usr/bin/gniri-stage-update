#!/usr/bin/env python3
"""Enroll the installed image in signature verification, then stage updates."""
import json
from pathlib import Path
import subprocess

def stage_update(reference, status):
    if not reference.startswith('ghcr.io/'):
        print('Local development image: automatic updates are unavailable.')
        return
    if status['spec'].get('bootOrder') == 'rollback' or status['status'].get('rollbackQueued'):
        raise SystemExit('Rollback queued; automatic update skipped.')
    booted = status['status']['booted']['image']['image']
    target = status['spec'].get('image')
    if (booted['image'] != reference or not target or target['image'] != reference
            or target['transport'] != 'registry'):
        raise SystemExit('Update source differs from this image. Review the source before updating.')
    if target.get('signature') != 'containerPolicy':
        # Anaconda's bootc command does not expose the policy flag. Enroll
        # before the first automatic update; switch also stages the update.
        subprocess.run(['bootc', 'switch', '--enforce-container-sigpolicy', reference], check=True)
    else:
        subprocess.run(['bootc', 'upgrade'], check=True)


def main():
    reference = Path('/usr/share/gniri/image-reference').read_text().strip()
    status = json.loads(subprocess.check_output(['bootc', 'status', '--json']))
    stage_update(reference, status)


if __name__ == '__main__':
    main()
