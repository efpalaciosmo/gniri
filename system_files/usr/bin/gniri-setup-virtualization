#!/usr/bin/env bash
# Deliberate, post-install authorization for ONE named local account.
set -euo pipefail
if (( EUID != 0 )) || (( $# != 1 )); then
    printf 'Usage: sudo gniri-setup-virtualization USERNAME\n' >&2
    exit 1
fi
user=$1
[[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || { printf 'Invalid user name\n' >&2; exit 1; }
IFS=: read -r _ _ uid _ _ home _ < <(getent passwd "$user")
[[ ${uid:-0} -ge 1000 && $home == /var/home/* || ${uid:-0} -ge 1000 && $home == /home/* ]] || {
    printf 'Select an existing regular local user\n' >&2; exit 1;
}
awk -F: -v wanted="$user" '$1 == wanted { found=1 } END { exit !found }' /etc/passwd || {
    printf 'Account must be local\n' >&2; exit 1;
}
install -d -m 0755 /etc/polkit-1/rules.d
usermod --append --groups libvirt "$user"
# Override Fedora's broad libvirt-group grant: only the explicitly named
# user receives passwordless management. Other users must authenticate.
cat > /etc/polkit-1/rules.d/00-gniri-libvirt.rules <<EOF
polkit.addRule(function(action, subject) {
    if (action.id == "org.libvirt.unix.manage") {
        if (subject.user == "$user" && subject.local && subject.active)
            return polkit.Result.YES;
        return polkit.Result.AUTH_ADMIN;
    }
});
EOF
chmod 0644 /etc/polkit-1/rules.d/00-gniri-libvirt.rules
restorecon /etc/polkit-1/rules.d/00-gniri-libvirt.rules
systemctl start virtqemud.socket virtnetworkd.socket virtstoraged.socket
virsh -c qemu:///system net-autostart default
if [[ $(LC_ALL=C virsh -c qemu:///system net-info default | awk '/^Active:/ {print $2}') != yes ]]; then
    virsh -c qemu:///system net-start default
fi
printf 'Authorized %s. Log out completely and log back in.\n' "$user"
printf 'This grants powerful host-management privileges, not just KVM access.\n'
