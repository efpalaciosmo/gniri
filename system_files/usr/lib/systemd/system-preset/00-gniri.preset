enable gdm.service
enable NetworkManager.service
enable NetworkManager-wait-online.service
enable bluetooth.service
enable firewalld.service
enable tailscaled.service
enable bootc-fetch-apply-updates.timer
enable virtqemud.socket
enable virtnetworkd.socket
enable virtnodedevd.socket
enable virtnwfilterd.socket
enable virtsecretd.socket
enable virtstoraged.socket
enable virtproxyd.socket
enable virtlogd.socket
enable virtlockd.socket
disable libvirtd.service
disable libvirtd.socket
disable libvirtd-ro.socket
disable libvirtd-admin.socket
disable libvirtd-tcp.socket
disable libvirtd-tls.socket
disable virtproxyd-tcp.socket
disable virtproxyd-tls.socket
disable sshd.service
disable rpm-ostreed-automatic.timer
disable dnf-automatic.timer
