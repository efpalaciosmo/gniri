[Unit]
Description=Add Flathub for this user only (no apps are installed)
# Do not make the target wait for this network operation. Explicit ordering
# starts it only after the desktop target is active, even when offline.
DefaultDependencies=no
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
RemainAfterExit=yes
Restart=on-failure
RestartSec=1min
TimeoutStartSec=2min

[Install]
WantedBy=graphical-session.target
