[Unit]
Description=Configure user Flathub and refresh its signing keys (no apps are installed)
# Do not make the target wait for this network operation. Explicit ordering
# starts it only after the desktop target is active, even when offline.
DefaultDependencies=no
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/gniri-flathub-user
RemainAfterExit=yes
Restart=on-failure
RestartSec=1min
TimeoutStartSec=2min

[Install]
WantedBy=graphical-session.target
